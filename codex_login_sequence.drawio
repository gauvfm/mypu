        <mxCell id="msg17-lbl" value="17. Signed in ✓" style="text;html=1;align=center;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="140" y="885" width="200" height="20" as="geometry" />
        </mxCell>

        <!-- Bottom lifeline boxes -->
        <mxCell id="actor-dev2" value="Developer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="1">
