        <mxCell id="ll-browser" style="endArrow=none;dashed=1;html=1;strokeColor=#d6b656;strokeWidth=1.5" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="110" as="sourcePoint" />
            <mxPoint x="560" y="950" as="targetPoint" />
