          <mxGeometry x="260" y="940" width="160" height="30" as="geometry" />
        </mxCell>

        <mxCell id="lane-browser2" value="Browser" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="480" y="940" width="160" height="30" as="geometry" />
        </mxCell>

        <mxCell id="lane-auth2" value="auth.openai.com" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1" vertex="1" parent="1">
