        <mxCell id="lane-auth" value="auth.openai.com&#10;(OIDC AS + SAML SP)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="700" y="70" width="180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="lane-ping" value="FMSSO Ping&#10;(SAML IdP)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="940" y="70" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="lane-disk" value="OS Keyring /&#10;~/.codex/auth.json" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1160" y="70" width="180" height="40" as="geometry" />
