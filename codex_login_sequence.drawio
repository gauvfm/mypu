          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1020" y="110" as="sourcePoint" />
            <mxPoint x="1020" y="950" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="ll-disk" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;strokeWidth=1.5" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1250" y="110" as="sourcePoint" />
            <mxPoint x="1250" y="950" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 1: Dev triggers login -->
        <mxCell id="msg1" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1.5" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="150" as="sourcePoint" />
            <mxPoint x="340" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg1-lbl" value="1. codex login&#10;(or click Sign in)" style="text;html=1;align=center;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="140" y="120" width="200" height="30" as="geometry" />
        </mxCell>

        <!-- Note: PKCE gen + listener bind -->
        <mxCell id="note1" value="Generate PKCE verifier + S256 challenge&#10;Bind listener on http://localhost:1455/auth/callback" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="240" y="170" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- Step 2: Client opens browser -->
        <mxCell id="msg2" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.5" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="240" as="sourcePoint" />
            <mxPoint x="560" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg2-lbl" value="2. open browser →&#10;auth.openai.com/oauth/authorize?response_type=code&#10;&amp;client_id&amp;redirect_uri=localhost:1455&amp;code_challenge&amp;state" style="text;html=1;align=center;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="345" y="210" width="350" height="35" as="geometry" />
        </mxCell>

        <!-- Step 3: Browser GET /authorize -->
        <mxCell id="msg3" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.5" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="280" as="sourcePoint" />
            <mxPoint x="790" y="280" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg3-lbl" value="3. GET /oauth/authorize" style="text;html=1;align=center;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="565" y="255" width="225" height="20" as="geometry" />
        </mxCell>

        <!-- Note: domain lookup -->
        <mxCell id="note2" value="Match email domain → verified SAML connection&#10;Build AuthnRequest, redirect to IdP" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="680" y="290" width="240" height="40" as="geometry" />
        </mxCell>

        <!-- Step 4: 302 to Ping -->
        <mxCell id="msg4" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.5;dashed=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="790" y="345" as="sourcePoint" />
            <mxPoint x="560" y="345" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg4-lbl" value="4. 302 redirect to FMSSO Ping (SAMLRequest)" style="text;html=1;align=center;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="565" y="325" width="225" height="20" as="geometry" />
        </mxCell>

        <!-- Step 5: Browser GET Ping -->
        <mxCell id="msg5" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.5" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="385" as="sourcePoint" />
            <mxPoint x="1020" y="385" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg5-lbl" value="5. GET /SSO?SAMLRequest=..." style="text;html=1;align=center;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="700" y="365" width="240" height="20" as="geometry" />
        </mxCell>

        <!-- Step 6: Ping returns login page -->
        <mxCell id="msg6" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.5;dashed=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1020" y="420" as="sourcePoint" />
            <mxPoint x="560" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg6-lbl" value="6. Corporate login page" style="text;html=1;align=center;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="700" y="400" width="240" height="20" as="geometry" />
        </mxCell>

        <!-- Step 7: User enters creds at browser -->
        <mxCell id="msg7" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.5" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="455" as="sourcePoint" />
            <mxPoint x="560" y="455" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg7-lbl" value="7. Enter corporate creds + MFA" style="text;html=1;align=center;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="200" y="435" width="320" height="20" as="geometry" />
        </mxCell>

        <!-- Step 8: Browser POST creds to Ping -->
        <mxCell id="msg8" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.5" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="490" as="sourcePoint" />
            <mxPoint x="1020" y="490" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg8-lbl" value="8. POST credentials" style="text;html=1;align=center;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="700" y="470" width="240" height="20" as="geometry" />
        </mxCell>

        <!-- Step 9: Ping → SAMLResponse via auto-submit -->
        <mxCell id="msg9" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.5;dashed=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1020" y="525" as="sourcePoint" />
            <mxPoint x="560" y="525" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg9-lbl" value="9. HTML auto-submit form with signed SAMLResponse" style="text;html=1;align=center;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="640" y="505" width="360" height="20" as="geometry" />
        </mxCell>

        <!-- Step 10: Browser POST SAMLResponse to auth -->
        <mxCell id="msg10" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.5" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="560" as="sourcePoint" />
            <mxPoint x="790" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg10-lbl" value="10. POST /saml/acs (SAMLResponse)" style="text;html=1;align=center;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="565" y="540" width="225" height="20" as="geometry" />
        </mxCell>

        <!-- Note: validate assertion -->
        <mxCell id="note3" value="Validate signature, audience, timestamps&#10;Map SAML attributes → OIDC session" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="680" y="570" width="240" height="40" as="geometry" />
        </mxCell>

        <!-- Step 11: 302 to localhost callback with code -->
        <mxCell id="msg11" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.5;dashed=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="790" y="625" as="sourcePoint" />
            <mxPoint x="560" y="625" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg11-lbl" value="11. 302 to localhost:1455/auth/callback?code=AUTH_CODE&amp;state=..." style="text;html=1;align=center;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="475" y="605" width="400" height="20" as="geometry" />
        </mxCell>

        <!-- Step 12: Browser GET to local callback -->
        <mxCell id="msg12" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.5" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="660" as="sourcePoint" />
            <mxPoint x="340" y="660" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg12-lbl" value="12. GET /auth/callback?code=...&amp;state=..." style="text;html=1;align=center;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="345" y="640" width="225" height="20" as="geometry" />
        </mxCell>

        <!-- Note: validate state -->
        <mxCell id="note4" value="Validate state matches what client sent (CSRF guard)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="240" y="675" width="250" height="30" as="geometry" />
        </mxCell>

        <!-- Step 13: Client POST /oauth/token -->
        <mxCell id="msg13" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.5" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="730" as="sourcePoint" />
            <mxPoint x="790" y="730" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg13-lbl" value="13. POST /oauth/token (grant_type=authorization_code, code, code_verifier, client_id)" style="text;html=1;align=center;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="345" y="710" width="450" height="20" as="geometry" />
        </mxCell>

        <!-- Note: verify PKCE -->
        <mxCell id="note5" value="Verify auth code + PKCE verifier hashes to original challenge" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="680" y="745" width="260" height="30" as="geometry" />
        </mxCell>

        <!-- Step 14: Return tokens -->
        <mxCell id="msg14" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.5;dashed=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="790" y="795" as="sourcePoint" />
            <mxPoint x="340" y="795" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg14-lbl" value="14. id_token (JWT) + access_token (JWT) + refresh_token (opaque)" style="text;html=1;align=center;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="345" y="775" width="450" height="20" as="geometry" />
        </mxCell>

        <!-- Step 15: Store tokens -->
        <mxCell id="msg15" style="endArrow=classic;html=1;rounded=0;strokeWidth=1.5" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="835" as="sourcePoint" />
            <mxPoint x="1250" y="835" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg15-lbl" value="15. Store tokens (keyring preferred, or ~/.codex/auth.json)" style="text;html=1;align=center;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="600" y="815" width="400" height="20" as="geometry" />
        </mxCell>

