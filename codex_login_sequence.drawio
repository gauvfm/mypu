        <mxCell id="lane-ping2" value="FMSSO Ping" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="940" y="940" width="160" height="30" as="geometry" />
