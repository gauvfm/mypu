{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ManagePrivateHubLifecycle",
            "Effect": "Allow",
            "Action": [
                "sagemaker:CreateHub",
                "sagemaker:UpdateHub",
                "sagemaker:DeleteHub",
                "sagemaker:ImportHubContent",
                "sagemaker:DeleteHubContent",
                "sagemaker:AddTags"
            ],
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "aws:RequestTag/ASN": "ALPHA",
                    "aws:RequestTag/ASSETID": "GH9090"
                }
            }
        },
        {
            "Sid": "ManageEndpointLifecycle",
            "Effect": "Allow",
            "Action": [
                "sagemaker:CreateModel",
                "sagemaker:DeleteModel",
                "sagemaker:CreateEndpointConfig",
                "sagemaker:DeleteEndpointConfig",
                "sagemaker:CreateEndpoint",
                "sagemaker:UpdateEndpoint",
                "sagemaker:DeleteEndpoint",
                "sagemaker:AddTags"
            ],
            "Resource": "*",
            "Condition": {
                "Bool": {
                    "sagemaker:NetworkIsolation": "true"
                },
                "Null": {
                    "sagemaker:VpcConfig": "false"
                },
                "StringEquals": {
                    "aws:RequestTag/ASN": "ALPHA",
                    "aws:RequestTag/ASSETID": "GH9090"
                }
            }
        },
        {
            "Sid": "MetadataDiscoveryOnly",
            "Effect": "Allow",
            "Action": [
                "sagemaker:DescribeHub",
                "sagemaker:ListHubs",
                "sagemaker:DescribeHubContent",
                "sagemaker:ListHubContents",
                "sagemaker:DescribeModel",
                "sagemaker:DescribeEndpointConfig",
                "sagemaker:DescribeEndpoint"
            ],
            "Resource": "*"
        },
        {
            "Sid": "StrictDenyWeightDownload",
            "Effect": "Deny",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::jumpstart-cache-prod-*/*"
        }
    ]
}

--
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "RestrictS3ToApprovedWeights",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::jumpstart-cache-prod-${REGION}",
                "arn:aws:s3:::jumpstart-cache-prod-${REGION}/<PLACEHOLDER_MODEL_ID>/*"
            ]
        },
        {
            "Sid": "AllowECRInferenceImage",
            "Effect": "Allow",
            "Action": [
                "ecr:BatchCheckLayerAvailability",
                "ecr:GetDownloadUrlForLayer",
                "ecr:BatchGetImage"
            ],
            "Resource": "arn:aws:ecr:${REGION}:763104351884:repository/huggingface-pytorch-inference"
        },
        {
            "Sid": "AllowEssentialLogging",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents",
                "cloudwatch:PutMetricData"
            ],
            "Resource": "*"
        }
    ]
}