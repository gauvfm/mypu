        <mxCell id="BbJFczRT-OG58G1Epdaa-55" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Agent to Agent or Agent to MCP with in Same App should use AuthZ&lt;div&gt;doesn&#39;t need to go via any GW&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;When I say MCPServer it can have multiple Tools/Resources with mip-scopes&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;I have show IDP+AuthServer(AS), please connect as needed&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Agents have multiple skills and each agent has AgentCard as well&lt;/div&gt;" vertex="1">
