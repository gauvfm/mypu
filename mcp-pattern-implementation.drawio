        <mxCell id="api-comp" value="API Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="155" width="200" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="api-stack" value="&amp;middot; JWT validation&amp;#xa;  (iss, aud, sig)&amp;#xa;&amp;middot; Coarse rate limit&amp;#xa;&amp;middot; Request validation&amp;#xa;&amp;middot; mTLS to MCP Gateway&amp;#xa;&amp;#xa;Controls: IAM-AUTHN-01" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#232F3E;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;fontStyle=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
