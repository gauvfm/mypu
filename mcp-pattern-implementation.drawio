        <mxCell id="kms-comp" value="Key Management" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A4FFF;strokeWidth=1.5;fontSize=11;fontColor=#8A4FFF;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1480" y="155" width="200" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="kms-stack" value="&amp;middot; FIPS 140-3 HSM&amp;#xa;&amp;middot; Envelope encryption&amp;#xa;&amp;middot; DPoP key storage&amp;#xa;&amp;middot; Audit-only access&amp;#xa;&amp;#xa;Controls: CRY-03" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A4FFF;strokeWidth=1.5;fontSize=10;fontColor=#8A4FFF;fontStyle=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1480" y="179" width="200" height="161" as="geometry"/>
        </mxCell>
        <mxCell id="mesh-comp" value="Service Mesh · mTLS everywhere" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1700" y="155" width="460" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="mesh-stack" value="&amp;middot; SPIFFE / SPIRE workload identity&amp;#xa;&amp;middot; SVID X.509 (TTL &amp;lt; 1h, auto-rotate)&amp;#xa;&amp;middot; mTLS on every internal hop&amp;#xa;&amp;middot; East-west deny by default; per-server NetworkPolicy&amp;#xa;&amp;middot; SDS for cert distribution&amp;#xa;&amp;#xa;Controls: IAM-AUTHN-02, IAM-AUTHN-03, NET-04" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#232F3E;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;fontStyle=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1700" y="179" width="460" height="161" as="geometry"/>
        </mxCell>
        <mxCell id="app-row-label" value="Application &amp; enforcement layer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#545B64;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="380" width="300" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="build-frame" value="Build agent component   (enterprise compute)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F8F9FA;strokeColor=#232F3E;strokeWidth=1.5;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fontStyle=2;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="580" y="405" width="320" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="mcp-host" value="MCP Host (1:1 client per server)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;strokeWidth=2;fontSize=11;fontColor=#1A73E8;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="440" width="280" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="mcp-host-stack" value="&amp;middot; OS keystore vault (Keychain/DPAPI)&amp;#xa;&amp;middot; Per-server token isolation&amp;#xa;&amp;middot; PKCE verifier never persisted&amp;#xa;&amp;middot; Provenance-tagged context&amp;#xa;&amp;middot; Sampling consent gating&amp;#xa;&amp;middot; Recursion depth cap (3)&amp;#xa;&amp;middot; mTLS client cert per workload&amp;#xa;&amp;middot; PRM discovery + DPoP proof&amp;#xa;&amp;#xa;Controls: HOST-CLI-*, HOST-VAULT-*,&amp;#xa;HOST-CTX-*, HOST-PRM-01, HOST-DPOP-01" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;strokeWidth=2;fontSize=10;fontColor=#1A73E8;fontStyle=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="464" width="280" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="gw-frame" value="MCP Gateway · Policy Enforcement Point" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A73E8;strokeColor=#1A73E8;strokeWidth=2;fontSize=12;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="920" y="405" width="540" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="gw-subtitle" value="MCP-protocol-aware chokepoint &amp;middot; v1.1 spec aligned (2025-11-25)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#1A73E8;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="920" y="433" width="540" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="gw-fn-1" value="01 OAuth 2.1 RS + PRM (RFC 9728)&amp;#xa;02 Token Exchange (RFC 8693)&amp;#xa;03 Resource Indicators (RFC 8707)&amp;#xa;04 Registry + namespace + hash verify&amp;#xa;05 Schema firewall + protocol-version&amp;#xa;06 Prompt-injection scan (input)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;strokeWidth=2;fontSize=10;fontColor=#1A73E8;fontStyle=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="455" width="270" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="gw-fn-2" value="07 PDP call + annotation policy&amp;#xa;08 Elicitation routing (form vs URL)&amp;#xa;09 Rate limit + Tasks lifecycle&amp;#xa;10 Output DLP + structuredContent&amp;#xa;11 Sampling-request mediation&amp;#xa;12 A2A boundary + audit + kill-switch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;strokeWidth=2;fontSize=10;fontColor=#1A73E8;fontStyle=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1190" y="455" width="270" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="gw-faildesign" value="&amp;#x26A0; FAIL CLOSED: Registry, PDP, AS, DLP all required. Any unreachable &amp;rarr; deny." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEEF0;strokeColor=#DD344C;strokeWidth=2;fontSize=10;fontColor=#DD344C;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="920" y="595" width="540" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="gw-tech" value="Implementation: agentgateway / kgateway / Envoy + filter / Kong AI Gateway" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#1A73E8;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="920" y="638" width="540" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="registry-comp" value="MCP Registry · Trust Anchor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A4FFF;strokeWidth=1.5;fontSize=11;fontColor=#8A4FFF;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1480" y="405" width="680" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="registry-stack" value="&amp;middot; Signed manifests (sigstore/cosign + Fulcio)&amp;#xa;&amp;middot; Reverse-DNS namespace auth (com.example/server)&amp;#xa;&amp;middot; Hash-drift detection (15-min scanner)&amp;#xa;&amp;middot; Status: approved / deprecated / revoked&amp;#xa;&amp;middot; Syncs from registry.modelcontextprotocol.io (read-only)&amp;#xa;&amp;#xa;Controls: SUP-01, 02, 04, 09" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A4FFF;strokeWidth=1.5;fontSize=10;fontColor=#8A4FFF;fontStyle=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1480" y="429" width="680" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="llm-pool" value="Internal LLM Pool · Model Garden" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="855" width="280" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="llm-pool-stack" value="&amp;middot; Per-model policy + LLM guardrails&amp;#xa;&amp;middot; No internet egress (NET-03)&amp;#xa;&amp;middot; mTLS + service account token&amp;#xa;&amp;middot; Tool-use intent emitted, not executed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#232F3E;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;fontStyle=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="879" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="mcp-srv-a" value="MCP Server A &amp;middot; readOnlyHint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#0E8F6E;strokeWidth=1.5;fontSize=11;fontColor=#0E8F6E;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="940" y="855" width="280" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="mcp-srv-a-stack" value="&amp;middot; OAuth Resource Server&amp;#xa;&amp;middot; PRM endpoint (/.well-known)&amp;#xa;&amp;middot; Sandbox: non-root, RO FS, seccomp&amp;#xa;&amp;middot; NetworkPolicy: zero east-west&amp;#xa;&amp;middot; SPIFFE SVID (TTL &amp;lt; 1h)&amp;#xa;&amp;middot; Tools: read-only operations&amp;#xa;&amp;#xa;Controls: RUN-01, NET-04, IAM-AUTHN-02" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#0E8F6E;strokeWidth=1.5;fontSize=10;fontColor=#0E8F6E;fontStyle=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="940" y="879" width="280" height="156" as="geometry"/>
        </mxCell>
        <mxCell id="mcp-srv-b" value="MCP Server B &amp;middot; destructiveHint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;strokeWidth=1.5;fontSize=11;fontColor=#1A73E8;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="855" width="280" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="mcp-srv-b-stack" value="&amp;middot; OAuth Resource Server&amp;#xa;&amp;middot; PRM endpoint (/.well-known)&amp;#xa;&amp;middot; DPoP-bound tokens REQUIRED&amp;#xa;&amp;middot; structuredContent enforced&amp;#xa;&amp;middot; Step-up auth required&amp;#xa;&amp;middot; Tools: write/destructive ops&amp;#xa;&amp;#xa;Controls: IAM-AUTHN-10, OUT-06, AUTHZ-08, IAM-AUTHN-08" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;strokeWidth=1.5;fontSize=10;fontColor=#1A73E8;fontStyle=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="879" width="280" height="156" as="geometry"/>
        </mxCell>
        <mxCell id="mcp-srv-c" value="MCP Server C &amp;middot; HIGH RISK / openWorldHint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEEF0;strokeColor=#DD344C;strokeWidth=2;fontSize=11;fontColor=#DD344C;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1540" y="855" width="280" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="mcp-srv-c-stack" value="&amp;middot; TEE: Nitro Enclave / Intel TDX&amp;#xa;&amp;middot; Remote attestation REQUIRED&amp;#xa;&amp;middot; microVM (Firecracker) isolation&amp;#xa;&amp;middot; 3rd-party / untrusted code&amp;#xa;&amp;middot; Egress: backend allow-list only&amp;#xa;&amp;middot; Tools: external/untrusted calls&amp;#xa;&amp;#xa;Controls: RUN-06, NET-03, NET-04" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEEF0;strokeColor=#DD344C;strokeWidth=2;fontSize=10;fontColor=#DD344C;fontStyle=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
