        <mxCell id="buy-frame" value="Buy agent component   (SaaS provider runtime · enterprise has zero code-level control)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#7D3C00;strokeWidth=1.5;align=left;verticalAlign=top;fontSize=10;fontColor=#7D3C00;fontStyle=2;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
