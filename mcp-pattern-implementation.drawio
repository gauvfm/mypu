        <mxCell id="idp-comp" value="IDP / Authorization Server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A4FFF;strokeWidth=1.5;fontSize=11;fontColor=#8A4FFF;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="155" width="320" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="idp-stack" value="&amp;middot; OAuth 2.1 + PKCE&amp;#xa;&amp;middot; OIDC Discovery 1.0&amp;#xa;&amp;middot; Token Exchange (RFC 8693)&amp;#xa;&amp;middot; DPoP issuance (RFC 9449)&amp;#xa;&amp;middot; Step-up MFA &amp;middot; Revocation (7009)&amp;#xa;&amp;middot; Pre-registered clients only&amp;#xa;&amp;#xa;Controls: IAM-AUTHN-01, 04, 05, 08, 09, 10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A4FFF;strokeWidth=1.5;fontSize=10;fontColor=#8A4FFF;fontStyle=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="179" width="320" height="161" as="geometry"/>
