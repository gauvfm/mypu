        <mxCell id="edge-stack" value="&amp;middot; TLS 1.3 termination&amp;#xa;&amp;middot; mTLS client cert pinning&amp;#xa;&amp;middot; IP allow-list per SaaS provider&amp;#xa;&amp;middot; WAF managed rule groups&amp;#xa;&amp;middot; DDoS / L7 inspection&amp;#xa;&amp;#xa;Controls: NET-01, NET-02, IAM-AUTHN-03, CRY-01" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#232F3E;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;fontStyle=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="179" width="320" height="161" as="geometry"/>
