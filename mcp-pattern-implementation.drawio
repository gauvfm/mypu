        <mxCell id="buy-mcpclient" value="MCP Client (in SaaS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D3C00;strokeWidth=2;fontSize=11;fontColor=#7D3C00;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="420" width="410" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="buy-mcpclient-stack" value="Security stack (vendor-implemented):&amp;#xa;· Pre-registered OAuth client (no DCR)&amp;#xa;· Per-tenant client cert (mTLS)&amp;#xa;· DPoP-bound tokens (RFC 9449)&amp;#xa;· PRM discovery (RFC 9728)&amp;#xa;· OAuth 2.1 + PKCE federation to enterprise IDP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D3C00;strokeWidth=2;fontSize=10;fontColor=#7D3C00;fontStyle=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="444" width="410" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="buy-governance" value="Vendor governance (compensating controls):&amp;#xa;· DPA + sub-processor list on file&amp;#xa;· SOC 2 Type II / ISO 27001 attestations&amp;#xa;· HOST-* controls via vendor contract (~60% coverage)&amp;#xa;· No code-level visibility &amp;mdash; see §09 Residual Risks&amp;#xa;· Token + network edge are the only enforceable controls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D3C00;strokeWidth=1;fontSize=9;fontColor=#7D3C00;fontStyle=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;dashed=1;dashPattern=4 3;" vertex="1" parent="1">
          <mxGeometry x="90" y="555" width="410" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="buy-restriction" value="&amp;#x26A0; RESTRICTED TOOL SURFACE for buy agents&amp;#xa;Read-mostly · destructive blocked · classification &amp;le; Internal&amp;#xa;Tighter rate limits · stricter response redaction · per-tenant kill switch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE5CC;strokeColor=#7D3C00;strokeWidth=2;fontSize=10;fontColor=#7D3C00;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="770" width="460" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="zone-a-summary" value="Maps to Build vs Buy asymmetry:&amp;#xa;Buy estate has weaker host-side controls&amp;#xa;(can&amp;apos;t implement HOST-* yourself).&amp;#xa;Compensate by tightening at the gateway:&amp;#xa;AUTHZ-05, OUT-02, NET-07, IR-01." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D3C00;strokeWidth=1;fontSize=9;fontColor=#7D3C00;fontStyle=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;dashed=1;dashPattern=4 3;" vertex="1" parent="1">
          <mxGeometry x="60" y="880" width="460" height="110" as="geometry"/>
        </mxCell>
