        <mxCell id="zone-a" value="Zone A · Untrusted · SaaS / PaaS    (outside enterprise control)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#FAF6F2;strokeColor=#7D3C00;strokeWidth=2;align=left;verticalAlign=top;fontSize=11;fontColor=#7D3C00;fontStyle=3;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
