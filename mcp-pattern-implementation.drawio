        <mxCell id="edge-comp" value="Edge component &amp;mdash; WAF + Ingress Proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
