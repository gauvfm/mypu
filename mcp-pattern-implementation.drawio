        <mxCell id="buy-llm" value="3rd-party LLM&amp;#xa;(GPT-4o · Claude · Gemini)&amp;#xa;SaaS-managed runtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6EC;strokeColor=#7D3C00;strokeWidth=1.5;fontSize=10;fontColor=#7D3C00;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
