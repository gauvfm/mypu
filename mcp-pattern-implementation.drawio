        <mxCell id="backend-stack" value="&amp;middot; RDS &amp;middot; S3 &amp;middot; DynamoDB&amp;#xa;&amp;middot; Internal SaaS via PrivateLink&amp;#xa;&amp;middot; mTLS + SVID workload identity&amp;#xa;&amp;middot; User context via signed OBO header&amp;#xa;&amp;middot; Network FW for external SaaS egress&amp;#xa;&amp;middot; Row-level security where supported&amp;#xa;&amp;#xa;Controls: IAM-AUTHN-02, AUTHZ-04, NET-03" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#232F3E;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;fontStyle=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
